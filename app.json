{
  "expo": {
    "name": "GREED",
    "slug": "greed",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "greed",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#141210",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#141210"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.passagelab.greed",
      "infoPlist": {
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "com.passagelab.greed",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#141210"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-asset"],
    "extra": {
      "eas": {}
    }
  }
}
